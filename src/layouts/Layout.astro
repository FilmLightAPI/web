---
const categories = [
	{ name: "All", icon: "🏠", path: "/web/" },
	{ name: "App Scripts", icon: "🖥️", path: "/web/#scripts" },
	{ name: "Shaders", icon: "🎨", path: "/web/#shaders" },
	{ name: "FLAPI Tools", icon: "🛠️", path: "/web/#ai" },
];

const { frontmatter } = Astro.props;

let sourceUrl = null;
if (Astro.url.pathname.includes("/software/")) {
	const urlname = encodeURIComponent(frontmatter.name);
	const categoryPath = encodeURIComponent(frontmatter.category);
	sourceUrl = `https://github.com/FilmLightAPI/enhancements/tree/main/${categoryPath}/${urlname}`;
}
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <meta name="google-site-verification" content="nU2ao2uaPFXrPu4zRpMaA4gijzKv2J9rFJcVhIekphA" />
		<link rel="icon" type="image/svg+xml" href="/web/favicon.svg" />
		<title>{frontmatter?.name || "fl-enhance"}</title>
	</head>
	<body>
		<div class="layout">
			<aside class="sidebar">
				<nav>
					{
						categories.map((cat) => (
							<a href={cat.path} class="sidebar-link">
								<span class="icon">{cat.icon}</span>
								<span>{cat.name}</span>
							</a>
						))
					}
				</nav>
			</aside>

			<div class="main-content">
				<main class="page-content">
					{
						frontmatter && frontmatter.name && (
							<div class="page-header">
								<div class="page-header-title">
									{frontmatter.icon && (
										<img
											src={frontmatter.icon}
											alt={frontmatter.name}
											class="page-icon"
										/>
									)}
									<h1 class="page-title">
										{frontmatter.name}
									</h1>
								</div>
								<div class="header-actions">
									{frontmatter.download && (
										<a
											href={frontmatter.download}
											class="download-btn"
											download
										>
											Download
										</a>
									)}
									{sourceUrl && (
										<a href={sourceUrl} class="source-btn">
											View Source
										</a>
									)}
								</div>
							</div>
						)
					}
					{
						frontmatter ? (
							<div class="markdown-card">
								<slot />
							</div>
						) : (
							<slot />
						)
					}
				</main>

				<footer class="footer">
					<div class="footer-inner">
						<div class="footer-brand">
							<span>fl-enhance</span>
						</div>
						<div class="footer-links">
							<div>
								<a
									href="https://github.com/FilmLightAPI/enhancements"
								>
									<svg
										width="15"
										height="15"
										viewBox="0 0 15 15"
										fill="currentColor"
										xmlns="http://www.w3.org/2000/svg"
									>
										<path
											d="M9.35762 2.14496C8.13548 1.86102 6.86444 1.86102 5.6423 2.14497C4.93642 1.71169 4.39704 1.51286 4.00502 1.42909C3.79189 1.38354 3.62296 1.37216 3.4959 1.37556C3.43249 1.37725 3.38001 1.38261 3.33821 1.38905C3.31733 1.39226 3.29919 1.39573 3.28375 1.39911C3.27603 1.4008 3.26899 1.40247 3.26264 1.40408L3.25362 1.40643L3.2495 1.40756L3.24753 1.40811L3.24563 1.40865C3.24562 1.40865 3.24563 1.40864 3.24563 1.40865C3.2452 1.40884 3.24731 1.41452 3.38299 1.88895L3.24563 1.40865C3.1036 1.44926 2.9868 1.55061 2.92657 1.68549C2.75841 2.06202 2.66657 2.46816 2.65635 2.88041C2.64875 3.18677 2.68634 3.49199 2.76743 3.78633C2.55433 4.04445 2.3807 4.33349 2.25276 4.64407C2.08484 5.05173 1.99894 5.4885 1.99998 5.92939C2.00011 7.48194 2.45815 8.52582 3.23873 9.19657C3.78563 9.66653 4.45048 9.91658 5.11619 10.0598C5.00626 10.3652 4.97773 10.6883 4.99998 11.0176V11.6158C4.59263 11.7015 4.31135 11.6744 4.11082 11.6082C3.85884 11.525 3.66566 11.3578 3.48139 11.1175C3.38806 10.9959 3.30208 10.8623 3.21179 10.7161L3.15448 10.6228C3.08377 10.5073 3.00746 10.3828 2.93045 10.2692C2.73964 9.9878 2.45813 9.63616 2.00195 9.51639L1.51834 9.38942L1.2644 10.3566L1.74801 10.4836C1.82746 10.5045 1.93204 10.5786 2.10279 10.8304C2.16553 10.9229 2.22538 11.0206 2.29372 11.1321C2.31518 11.1671 2.33753 11.2036 2.36102 11.2417C2.45488 11.3936 2.56253 11.5627 2.68796 11.7262C2.94119 12.0563 3.28597 12.389 3.79742 12.5578C4.14883 12.6738 4.54603 12.7016 4.99998 12.6319V14.5C4.99998 14.7761 5.22384 15 5.49998 15H9.49998C9.77613 15 9.99998 14.7761 9.99998 14.5V10.9375C9.99998 10.6217 9.98623 10.333 9.89735 10.0636C10.5597 9.92381 11.2193 9.67353 11.7626 9.20319C12.5429 8.52773 13 7.47445 13 5.9125L13 5.91089C12.9975 5.13212 12.7242 4.38197 12.2325 3.78635C12.3136 3.492 12.3512 3.18678 12.3436 2.88041C12.3334 2.46816 12.2416 2.06202 12.0734 1.68549C12.0131 1.55057 11.8963 1.44921 11.7542 1.40861L11.6169 1.88937C11.7542 1.40861 11.7528 1.40821 11.7523 1.40807L11.7504 1.40752L11.7462 1.4064L11.7372 1.40405C11.7309 1.40245 11.7238 1.40078 11.7161 1.39909C11.7007 1.39571 11.6826 1.39225 11.6617 1.38904C11.6199 1.38261 11.5674 1.37725 11.504 1.37556C11.3769 1.37216 11.2079 1.38354 10.9947 1.42908C10.6026 1.51286 10.0633 1.71168 9.35762 2.14496Z"
										></path>
									</svg>
									Github</a
								>
								<a href="/web/submit/">Submit an Enhancement</a>
							</div>
						</div>
					</div>
				</footer>
			</div>
		</div>
		<style is:global>
			:root {
				--bg-primary: oklch(0.205 0 0); /* gray-900 */
				--bg-lighter: oklch(0.237 0 0); /* gray-850 */
				--bg-secondary: oklch(0.269 0 0); /* gray-800 */
				--bg-banner: #4f46e5; /* indigo-600 */
				--text-primary: oklch(0.985 0 0); /* gray-50 */
				--text-secondary: oklch(0.87 0 0); /* gray-300 */
				--text-muted: oklch(0.708 0 0); /* gray-400 */
				--border-color: oklch(0.371 0 0); /* gray-700 */
				--border-hover: #6366f1; /* indigo-500 */
				--link-color: #818cf8; /* indigo-400 */
				--font-sans: ui-sans-serif, system-ui, -apple-system,
					BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue",
					Arial, sans-serif;
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				font-family: var(--font-sans);
				background-color: var(--bg-primary);
				color: var(--text-primary);
				min-height: 100vh;
			}

			a {
				text-decoration: none;
				color: inherit;
			}

			.layout {
				display: flex;
				flex-direction: column;
				min-height: calc(100vh - 40px);
			}

			@media (min-width: 768px) {
				.layout {
					flex-direction: row;
				}
			}

			/* Sidebar */
			.sidebar {
				display: none;
				width: 240px;
				flex-shrink: 0;
				border-right: 1px solid var(--border-color);
				padding: 16px 0;
			}

			@media (min-width: 768px) {
				.sidebar {
					display: block;
				}
			}

			.sidebar-link {
				display: flex;
				align-items: center;
				gap: 12px;
				padding: 8px 24px;
				font-size: 14px;
				font-weight: 500;
				color: var(--text-secondary);
				transition: background-color 0.2s;
			}

			.sidebar-link:hover {
				background-color: var(--bg-secondary);
				color: var(--text-primary);
			}

			.sidebar-link .icon {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 28px;
				height: 28px;
				border: 1px solid var(--border-color);
				border-radius: 6px;
				font-size: 14px;
			}

			/* Main Content */
			.main-content {
				flex: 1;
				display: flex;
				flex-direction: column;
				min-width: 0;
			}

			/* Page Content */
			.page-content {
				padding: 32px 24px;
				max-width: 1200px;
				width: 100%;
				margin: 0 auto;
				flex: 1;
			}

			.page-content p,
			.page-content li {
				color: var(--text-secondary);
				line-height: 1.6;
			}

			.page-content h1,
			.page-content h2,
			.page-content h3,
			.page-content h4,
			.page-content h5,
			.page-content h6 {
				color: var(--text-primary);
			}

			.page-content h1,
			.page-content h2,
			.page-content h3,
			.page-content h4,
			.page-content h5,
			.page-content h6 {
				color: var(--text-primary);
			}

			.page-header {
				display: flex;
				align-items: center;
				justify-content: flex-start;
				gap: 64px;
				margin-bottom: 32px;
			}

			.page-header-title {
				display: flex;
				align-items: center;
				gap: 12px;
			}

			.header-actions {
				display: flex;
				align-items: center;
				gap: 16px;
			}

			.download-btn {
				background-color: color-mix(
					in srgb,
					var(--link-color) 50%,
					var(--text-primary)
				);
				color: var(--bg-primary);
				padding: 8px 16px;
				border-radius: 6px;
				font-weight: 600;
				font-size: 14px;
				transition: opacity 0.2s;
			}

			.download-btn:hover {
				opacity: 0.8;
			}

			.source-btn {
				background-color: transparent;
				color: var(--link-color);
				border: 1px solid var(--link-color);
				padding: 7px 15px;
				border-radius: 6px;
				font-weight: 600;
				font-size: 14px;
				transition: all 0.2s;
			}

			.source-btn:hover {
				background-color: var(--link-color);
				color: var(--bg-primary);
			}

			.markdown-card {
				background-color: var(--bg-lighter);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 32px;
			}

			.markdown-card a {
				color: var(--link-color);
				text-decoration: underline;
				text-underline-offset: 4px;
				transition: color 0.2s;
			}

			.markdown-card a:hover {
				color: var(--text-primary);
			}

			.markdown-card img {
				max-width: 100%;
				height: auto;
				border-radius: 8px;
			}

			.page-header .page-title {
				margin-bottom: 0;
			}

			.page-icon {
				width: 64px;
				height: 64px;
				border-radius: 6px;
				aspect-ratio: 1 / 1;
				object-fit: contain;
			}

			.page-title {
				font-size: 36px;
				font-weight: 700;
				margin: 0 0 16px 0;
			}

			.page-description {
				font-size: 18px;
				color: var(--text-secondary);
				margin: 0 0 32px 0;
			}

			/* Search */
			.search-container {
				position: relative;
				display: flex;
				align-items: center;
				margin-bottom: 32px;
			}

			.search-icon {
				position: absolute;
				left: 12px;
				color: var(--text-muted);
			}

			.search-container input {
				width: 100%;
				padding: 12px 12px 12px 40px;
				border: 1px solid var(--border-color);
				border-radius: 8px;
				font-size: 15px;
				outline: none;
				transition: border-color 0.2s, box-shadow 0.2s;
			}

			.search-container input:focus {
				border-color: var(--border-hover);
				box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);
			}

			.search-container kbd {
				position: absolute;
				right: 12px;
				font-family: monospace;
				font-size: 12px;
				color: var(--text-muted);
				border: 1px solid var(--border-color);
				padding: 2px 6px;
				border-radius: 4px;
			}

			/* Grid */
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 16px;
			}

			.card {
				display: flex;
				align-items: center;
				padding: 12px;
				background-color: var(--bg-secondary);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				transition: border-color 0.2s, transform 0.2s;
			}

			.card:hover {
				border-color: var(--border-hover);
			}

			.card-icon-container {
				flex-shrink: 0;
				margin-right: 16px;
			}

			.card-icon {
				width: 64px;
				height: 64px;
				background-color: var(--border-color);
				border-radius: 8px;
				aspect-ratio: 1 / 1;
				object-fit: contain;
			}

			.card-content {
				flex: 1;
				min-width: 0;
			}

			.card-title {
				font-size: 16px;
				font-weight: 600;
				margin: 0 0 4px 0;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.card-desc {
				font-size: 13px;
				color: var(--text-secondary);
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* Footer */
			.footer {
				border-top: 1px solid var(--border-color);
				padding: 16px 24px 16px;
				margin-top: 16px;
			}

			.footer-inner {
				max-width: 1200px;
				margin: 0 auto;
				display: flex;
				flex-direction: column;
				gap: 16px;
			}

			@media (min-width: 768px) {
				.footer-inner {
					flex-direction: row;
					justify-content: space-between;
				}
			}

			.footer-brand {
				display: flex;
				align-items: center;
				gap: 12px;
				font-size: 20px;
				font-weight: 600;
			}

			.footer-links {
				display: flex;
				gap: 64px;
			}

			.footer-links h4 {
				font-size: 12px;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--text-muted);
				margin: 0 0 16px 0;
			}

			.footer-links a {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 14px;
				color: var(--text-secondary);
				margin-bottom: 12px;
			}

			.github-icon {
				height: 50px;
				width: auto;
			}

			.footer-links a:hover {
				color: var(--text-primary);
			}
		</style>
	</body>
</html>
